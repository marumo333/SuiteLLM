{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Write|Edit",
				"hooks": [
					{ "type": "command", "command": "node .claude/hooks/block_secret_write.mjs" }
				]
			},
			{
				"matcher": "Bash",
				"hooks": [
					{ "type": "command", "command": "node .claude/hooks/block_env_read.mjs" },
					{ "type": "command", "command": "node .claude/hooks/code_mode_guard.mjs" },
					{ "type": "command", "command": "node .claude/hooks/pre_commit_guard.mjs" }
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{ "type": "command", "command": "node .claude/hooks/post_task_reflect.mjs" }
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(node --test scripts/cycle-metrics.test.mjs)",
			"Bash(node --test scripts/commit-msg-lint.test.mjs)",
			"Bash(node --test scripts/git-commit-cmd.test.mjs)",
			"Bash(node --test scripts/commit-guard.test.mjs)",
			"Bash(node --test scripts/blocked-env.test.mjs)",
			"Bash(node --test scripts/lint-commit-range.test.mjs)",
			"Bash(node scripts/lint-commit-range.mjs:*)",
			"Bash(node scripts/commit-msg-lint.mjs:*)",
			"Bash(node scripts/run-pre-commit.mjs)",
			"Bash(node scripts/install-git-hooks.mjs)",
			"Bash(node scripts/feature-gate.mjs:*)",
			"Bash(node scripts/cycle-record.mjs:*)",
			"Bash(node scripts/cycle-metrics.mjs:*)",
			"Bash(node scripts/cycle-after-merge.mjs --dry-run:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git status)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(node .claude/hooks/:*)"
		],
		"deny": ["Read(./.env)", "Read(./.env.*)"]
	}
}
